from __future__ import annotations

import re
from pathlib import PurePosixPath
from typing import Final
import os
import subprocess

from langgraph.prebuilt import ToolRuntime
from langchain_core.tools import tool

from multi_agent_sdlc.state import DevState
from pathlib import Path


CODER_RUN_COMMAND_DESCRIPTION = """
Run the generated application inside the current project.

The `command` argument must be a JSON array of separate command arguments,
not a string containing a JSON array.

Examples below:

Correct:
{
  "command": ["uv", "run", "python", "-m", "terminal_calculator"]
}

Correct:
{
  "command": ["uv", "run", "calc", "2+2"]
}

Incorrect:
{
  "command": "[\\"uv\\", \\"run\\", \\"python\\", \\"-m\\", \\"terminal_calculator\\"]"
}

Incorrect:
{
  "command": ["uv run python -m terminal_calculator"]
}

Do not provide Python source code, shell syntax, pipes, redirects, or multiline
commands. Each command argument must be one list element.
""".strip()


ALLOWED_UV_SUBCOMMANDS: Final[set[str]] = {
    "sync",
    "add",
    "remove",
    "run",
}

PROHIBITED_RUN_TARGETS: Final[set[str]] = {
    "pytest",
    "ruff",
    "mypy",
    "flake8",
    "coverage",
    "coverage3",
    "pip",
    "pip3",
    "bash",
    "sh",
    "zsh",
    "fish",
    "cmd",
    "powershell",
    "pwsh",
}

PROHIBITED_PYTHON_MODULES: Final[set[str]] = {
    "pytest",
    "unittest",
    "coverage",
    "pip",
    "venv",
    "ensurepip",
    "subprocess",
}

PROHIBITED_UV_ADD_OPTIONS: Final[set[str]] = {
    "--dev",
    "--group",
    "--optional",
    "--editable",
    "-e",
    "--script",
    "--requirements",
    "-r",
    "--git",
    "--url",
}

PROHIBITED_UV_REMOVE_OPTIONS: Final[set[str]] = {
    "--dev",
    "--group",
    "--optional",
    "--script",
}

ALLOWED_UV_SYNC_OPTIONS: Final[set[str]] = {
    "--locked",
    "--frozen",
    "--no-dev",
    "--no-editable",
}

SHELL_TOKENS: Final[set[str]] = {
    "&&",
    "||",
    ";",
    "|",
    ">",
    ">>",
    "<",
    "<<",
    "2>",
    "2>>",
    "2>&1",
    "&>",
}

REMOTE_DEPENDENCY_PREFIXES: Final[tuple[str, ...]] = (
    "git+",
    "http://",
    "https://",
    "ssh://",
    "file:",
)

PACKAGE_NAME_PATTERN: Final[re.Pattern[str]] = re.compile(
    r"^[A-Za-z0-9][A-Za-z0-9._-]*"
    r"(?:\[[A-Za-z0-9._,-]+\])?"
    r"(?:===|==|~=|!=|<=|>=|<|>)?"
    r"[A-Za-z0-9.*+!_-]*$"
)

PYTHON_MODULE_PATTERN: Final[re.Pattern[str]] = re.compile(
    r"^[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*$"
)


class CommandValidationError(PermissionError):
    """Raised when a Coder command violates the execution policy."""


def validate_coder_command(command: list[str]) -> None:
    """Validate a command before passing it to subprocess.run.

    Allowed command categories:

    - uv sync
    - uv add <runtime-package>
    - uv remove <runtime-package>
    - uv run <project-entry-point> [arguments]
    - uv run python -m <application-module> [arguments]
    """
    _validate_command_shape(command)
    _reject_shell_syntax(command)
    _reject_unsafe_paths(command)

    if command[0] != "uv":
        raise CommandValidationError("Only commands executed through `uv` are allowed.")

    if len(command) < 2:
        raise ValueError("A uv subcommand is required.")

    subcommand = command[1]

    if subcommand not in ALLOWED_UV_SUBCOMMANDS:
        raise CommandValidationError(f"The Coder cannot execute `uv {subcommand}`.")

    if subcommand == "sync":
        _validate_uv_sync(command)
    elif subcommand == "add":
        _validate_uv_add(command)
    elif subcommand == "remove":
        _validate_uv_remove(command)
    elif subcommand == "run":
        _validate_uv_run(command)


def _validate_command_shape(command: list[str]) -> None:

    if not command:
        raise ValueError("The command cannot be empty.")

    for argument in command:
        if not isinstance(argument, str):
            raise TypeError("Every command argument must be a string.")

        if not argument:
            raise ValueError("Command arguments cannot be empty strings.")

        if "\n" in argument or "\r" in argument:
            raise CommandValidationError("Multiline command arguments are not allowed.")

        if "\x00" in argument:
            raise CommandValidationError(
                "Null bytes are not allowed in command arguments."
            )


def _reject_shell_syntax(command: list[str]) -> None:
    for argument in command:
        if argument in SHELL_TOKENS:
            raise CommandValidationError(f"Shell operator `{argument}` is not allowed.")

        if any(token in argument for token in ("&&", "||", "2>&1", "$(", "`")):
            raise CommandValidationError(f"Shell syntax is not allowed: {argument}")


def _reject_unsafe_paths(command: list[str]) -> None:
    for argument in command:
        # Ignore normal command-line flags.
        if argument.startswith("-"):
            continue

        normalised = argument.replace("\\", "/")

        if normalised.startswith("/"):
            raise CommandValidationError(f"Absolute paths are not allowed: {argument}")

        path = PurePosixPath(normalised)

        if ".." in path.parts:
            raise CommandValidationError(
                f"Parent-directory traversal is not allowed: {argument}"
            )


def _validate_uv_sync(command: list[str]) -> None:
    unsupported_options = [
        argument for argument in command[2:] if argument not in ALLOWED_UV_SYNC_OPTIONS
    ]

    if unsupported_options:
        raise CommandValidationError(
            "Unsupported `uv sync` arguments: " + ", ".join(unsupported_options)
        )


def _validate_uv_add(command: list[str]) -> None:
    arguments = command[2:]

    if not arguments:
        raise ValueError("`uv add` requires at least one runtime dependency.")

    _reject_dependency_options(
        arguments,
        prohibited_options=PROHIBITED_UV_ADD_OPTIONS,
        operation="add",
    )

    packages = [argument for argument in arguments if not argument.startswith("-")]

    if not packages:
        raise ValueError("`uv add` requires at least one runtime dependency.")

    for package in packages:
        _validate_dependency_specifier(package)


def _validate_uv_remove(command: list[str]) -> None:
    arguments = command[2:]

    if not arguments:
        raise ValueError("`uv remove` requires at least one runtime dependency.")

    _reject_dependency_options(
        arguments,
        prohibited_options=PROHIBITED_UV_REMOVE_OPTIONS,
        operation="remove",
    )

    packages = [argument for argument in arguments if not argument.startswith("-")]

    if not packages:
        raise ValueError("`uv remove` requires at least one runtime dependency.")

    for package in packages:
        # Removal should normally use the declared package name only.
        if not re.fullmatch(
            r"[A-Za-z0-9][A-Za-z0-9._-]*",
            package,
        ):
            raise CommandValidationError(
                f"Invalid package name for `uv remove`: {package}"
            )


def _reject_dependency_options(
    arguments: list[str],
    *,
    prohibited_options: set[str],
    operation: str,
) -> None:
    for argument in arguments:
        if argument in prohibited_options:
            raise CommandValidationError(
                f"`uv {operation} {argument}` is not allowed. "
                "The Coder may manage runtime dependencies only."
            )

        if argument.startswith("--group="):
            raise CommandValidationError(f"`uv {operation} --group` is not allowed.")

        if argument.startswith("--optional="):
            raise CommandValidationError(f"`uv {operation} --optional` is not allowed.")


def _validate_dependency_specifier(package: str) -> None:
    lowered = package.lower()

    if lowered.startswith(REMOTE_DEPENDENCY_PREFIXES):
        raise CommandValidationError(
            "Git, URL, SSH, and local-file dependencies are not allowed: " f"{package}"
        )

    if "@" in package:
        raise CommandValidationError(
            "Direct-reference dependencies are not allowed: " f"{package}"
        )

    if not PACKAGE_NAME_PATTERN.fullmatch(package):
        raise CommandValidationError(f"Invalid dependency specifier: {package}")


def _validate_uv_run(command: list[str]) -> None:
    arguments = command[2:]

    if not arguments:
        raise ValueError(
            "`uv run` requires an application entry point or Python module."
        )

    executable = arguments[0]
    executable_lower = executable.lower()

    if executable_lower in PROHIBITED_RUN_TARGETS:
        raise CommandValidationError(f"The Coder cannot execute `{executable}`.")

    if executable.startswith("-"):
        raise CommandValidationError(
            "`uv run` options are not allowed before the application target."
        )

    if executable_lower in {"python", "python3"}:
        _validate_python_module_execution(arguments)
        return

    _validate_project_entry_point(executable)


def _validate_python_module_execution(
    arguments: list[str],
) -> None:
    expected_format = "`uv run python -m <application_module> [arguments]`"

    if len(arguments) < 3:
        raise CommandValidationError(
            f"Python application execution must use {expected_format}."
        )

    if arguments[1] != "-m":
        raise CommandValidationError(
            "Direct Python scripts and inline Python are not allowed. "
            f"Use {expected_format}."
        )

    module_name = arguments[2]
    root_module = module_name.split(".", maxsplit=1)[0].lower()

    if module_name in {"-c", "-"}:
        raise CommandValidationError(
            "Inline Python and stdin-based Python execution are not allowed."
        )

    if not PYTHON_MODULE_PATTERN.fullmatch(module_name):
        raise CommandValidationError(f"Invalid Python module name: {module_name}")

    if (
        module_name.lower() in PROHIBITED_PYTHON_MODULES
        or root_module in PROHIBITED_PYTHON_MODULES
    ):
        raise CommandValidationError(
            f"The Coder cannot execute Python module `{module_name}`."
        )


def _validate_project_entry_point(executable: str) -> None:
    if "/" in executable or "\\" in executable:
        raise CommandValidationError(
            "Run a declared project entry point by name, not by path."
        )

    if not re.fullmatch(
        r"[A-Za-z0-9][A-Za-z0-9._-]*",
        executable,
    ):
        raise CommandValidationError(f"Invalid project entry point: {executable}")


def build_sandbox_environment() -> dict[str, str]:
    environment = os.environ.copy()

    environment.pop("VIRTUAL_ENV", None)
    environment.pop("PYTHONHOME", None)
    environment.pop("PYTHONPATH", None)

    return environment


@tool(
    "run_command",
    description=CODER_RUN_COMMAND_DESCRIPTION,
)
def run_command(
    command: list[str],
    runtime: ToolRuntime,
    timeout_seconds: int = 60,
) -> dict[str, object]:
    validate_coder_command(command)

    project_directory = get_project_directory(runtime)

    try:
        result = subprocess.run(
            command,
            cwd=project_directory,
            env=build_sandbox_environment(),
            capture_output=True,
            text=True,
            timeout=timeout_seconds,
            shell=False,
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        return {
            "command": command,
            "exit_code": None,
            "stdout": error.stdout or "",
            "stderr": error.stderr or "",
            "timed_out": True,
        }

    return {
        "command": command,
        "exit_code": result.returncode,
        "stdout": result.stdout.strip(),
        "stderr": result.stderr.strip(),
        "timed_out": False,
    }


def get_project_directory(
    runtime: ToolRuntime[DevState],
) -> Path:
    """Retrieve project directory"""

    project_directory = runtime.state.get("project_directory")

    if not project_directory:
        raise ValueError("project_directory is missing from the graph state.")

    directory = Path(project_directory)

    if not directory.is_dir():
        raise NotADirectoryError(f"Project directory does not exist: {directory}")

    return directory.resolve()
